# --- CONTAINER APP ---
APP_PORT_EXTERNAL=3000
APP_PORT_INTERNAL=3000

# --- MONGO DATABASE ---
MONGO_PORT_EXTERNAL=27017
MONGO_PORT_INTERNAL=27017
MONGO_HOST=mongodb
MONGO_DB=testdb

# --- MONGO EXPRESS ---
MONGO_EXPRESS_PORT_EXTERNAL=8081
MONGO_EXPRESS_PORT_INTERNAL=8081

# --- INTERNAL ---
ME_CONFIG_MONGODB_SERVER=${MONGO_HOST}
ME_CONFIG_MONGODB_PORT=${MONGO_PORT_INTERNAL}
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=admin
